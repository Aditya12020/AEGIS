# =====================================================================
# AEGIS Environmental Forensic Intelligence Platform
# Environment Configuration Template
# =====================================================================

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/aegis"

# JWT Secret (Mandatory in production)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars

# ---------------------------------------------------------------------
# External Earth Observation & MetOcean Data Providers
# (If omitted, system reports honest PROVIDER NOT CONFIGURED status)
# ---------------------------------------------------------------------

# 1. Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub Process API
# Register at: https://dataspace.copernicus.eu
# Generate OAuth client credentials under User Profile -> OAuth Clients
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_DATASPACE_CLIENT_ID=
COPERNICUS_DATASPACE_CLIENT_SECRET=

# 2. Copernicus Marine Service (CMEMS) - Physical Oceanography / Current
# Register at: https://marine.copernicus.eu
# Used by python copernicusmarine library for hydrodynamic current (uo, vo)
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=
COPERNICUS_MARINE_DATASET=cmems_mod_glo_phy_my_0.083deg_P1D-m

# 3. Copernicus Climate Change Service (C3S) - ECMWF ERA5 Atmospheric Wind
# Register at: https://cds.climate.copernicus.eu
# Go to your profile page and copy your Personal Access Token (PAT).
# The PAT is a UUID string (e.g. xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx).
# No UID: prefix needed — cdsapi >=0.7 uses PAT-only authentication.
# IMPORTANT: You must also accept the licence for the dataset at:
#   https://cds.climate.copernicus.eu/datasets/reanalysis-era5-single-levels?tab=download#manage-licences
ERA5_API_KEY=

# Optional: override the CDS API endpoint URL
# (default: https://cds.climate.copernicus.eu/api)
# ERA5_CDS_URL=https://cds.climate.copernicus.eu/api

# ---------------------------------------------------------------------
# Machine Learning (PyTorch U-Net ResNet-34 Segmentation)
# ---------------------------------------------------------------------
ML_SERVICE_URL=http://127.0.0.1:8000
PYTHON_EXECUTABLE=python
AEGIS_UNET_COMPATIBILITY_VERIFIED=true
AEGIS_UNET_THRESHOLD=0.5
